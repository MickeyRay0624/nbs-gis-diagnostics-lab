# Include alongside the existing /nbs-api/ location in the same server block.
# Only this authenticated binary-upload route accepts a large body. Keep the
# ordinary API's 220k body limit for JSON submissions.
location = /nbs-api/diagnostics/uploads {
    client_max_body_size 100m;
    client_body_timeout 120s;
    limit_req zone=nbs_water_api burst=20 nodelay;
    proxy_pass http://127.0.0.1:8021/api/diagnostics/uploads;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
    proxy_read_timeout 180s;
    proxy_buffering off;
}
