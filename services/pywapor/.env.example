# Visitors open a browser workspace automatically; no access-code form.
NBS_PUBLIC_ACCESS=true
# Match the externally visible API route. Local direct API uses /api.
NBS_SESSION_COOKIE_PATH=/nbs-api
NBS_SECURE_COOKIE=true
# Optional legacy keys retain access to existing analyst-owned tasks.
NBS_ACCESS_KEYS={}
# Administrators may set a lower minimum for a chosen code (12 or more).
NBS_MIN_ACCESS_CODE_LENGTH=32
NBS_ALLOWED_ORIGINS=https://lmqstudio.com
NBS_DATA_DIR=/data
NBS_JOB_TIMEOUT_SECONDS=14400
NBS_MAX_JOB_GB=20
NBS_MIN_FREE_GB=5
NBS_RETENTION_DAYS=30
# Enable only after provider access and a custom-area smoke run are verified.
NBS_ENABLE_CUSTOM=false
NBS_NASA_USERNAME=
NBS_NASA_PASSWORD=
# Legacy combined flag; per-source flags below take precedence.
NBS_EARTHDATA_VERIFIED=false
# Enable each source only after its authenticated end-to-end test passes.
NBS_GLDAS_VERIFIED=false
NBS_MODIS_VERIFIED=false
NBS_CDSE_USERNAME=
NBS_CDSE_PASSWORD=
NBS_CDS_TOKEN=
